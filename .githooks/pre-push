#!/bin/sh
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"

find_python() {
  for candidate in "${PYTHON:-}" python3 python; do
    if [ -n "$candidate" ] && command -v "$candidate" >/dev/null 2>&1; then
      if "$candidate" -c "import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)" >/dev/null 2>&1; then
        printf '%s\n' "$candidate"
        return 0
      fi
    fi
  done
  for candidate in \
    "$HOME"/*/.runtime/cpython-*/python.exe \
    "$HOME"/*/.venv/Scripts/python.exe \
    "$HOME"/*/.venv/bin/python \
    "${LOCALAPPDATA:-}/Programs/Python"/Python3*/python.exe
  do
    if [ -f "$candidate" ] && "$candidate" -c "import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)" >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

PY_BIN="$(find_python || true)"
if [ -z "$PY_BIN" ]; then
  echo "RELEASE CHECK BLOCKED: Python 3.10+ interpreter not found for pre-push guard (set PYTHON=/path/to/python)." >&2
  exit 1
fi

if [ -d "$REPO_ROOT/dist" ]; then
  exec "$PY_BIN" "$REPO_ROOT/tools/check_release.py" --root "$REPO_ROOT" --check-manifest --check-artifact "$REPO_ROOT/dist" --check-push "$@"
else
  exec "$PY_BIN" "$REPO_ROOT/tools/check_release.py" --root "$REPO_ROOT" --check-manifest --check-push "$@"
fi
